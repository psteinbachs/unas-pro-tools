{
  "dashboard": {
    "id": null,
    "uid": "unas-storage",
    "title": "UNAS Pro 8 - Storage",
    "tags": ["unas", "storage", "smart", "cache"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "SSD Cache Hit Rate",
        "type": "gauge",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
        "targets": [{"expr": "100 * rate(dmcache_read_hits_total[5m]) / (rate(dmcache_read_hits_total[5m]) + rate(dmcache_read_misses_total[5m]))", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 30}, {"color": "green", "value": 70}]}}}
      },
      {
        "id": 2,
        "title": "SSD Cache Usage",
        "type": "gauge",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
        "targets": [{"expr": "100 * dmcache_cache_used_blocks / dmcache_cache_total_blocks", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 95}]}}}
      },
      {
        "id": 3,
        "title": "Dirty Blocks",
        "type": "stat",
        "gridPos": {"h": 6, "w": 4, "x": 12, "y": 0},
        "targets": [{"expr": "dmcache_dirty_blocks", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10000}, {"color": "red", "value": 100000}]}}},
        "options": {"colorMode": "value", "graphMode": "area"}
      },
      {
        "id": 4,
        "title": "Cache Hit/Miss Rate",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6},
        "targets": [
          {"expr": "rate(dmcache_read_hits_total[5m])", "legendFormat": "Read Hits", "refId": "A"},
          {"expr": "rate(dmcache_read_misses_total[5m])", "legendFormat": "Read Misses", "refId": "B"},
          {"expr": "rate(dmcache_write_hits_total[5m])", "legendFormat": "Write Hits", "refId": "C"},
          {"expr": "rate(dmcache_write_misses_total[5m])", "legendFormat": "Write Misses", "refId": "D"}
        ],
        "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}}
      },
      {
        "id": 5,
        "title": "Drive Temperatures",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 12, "x": 12, "y": 6},
        "targets": [{"expr": "smartctl_device_temperature{temperature_type=\"current\"}", "legendFormat": "{{device}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "celsius", "custom": {"drawStyle": "line", "fillOpacity": 0}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 45}, {"color": "red", "value": 55}]}}}
      },
      {
        "id": 6,
        "title": "HDD Power-On Hours",
        "type": "bargauge",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 13},
        "targets": [{"expr": "smartctl_device_power_on_seconds{device=~\"sd.*\"} / 3600", "legendFormat": "{{device}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "h", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 35000}, {"color": "red", "value": 50000}]}}},
        "options": {"orientation": "horizontal", "displayMode": "gradient"}
      },
      {
        "id": 7,
        "title": "NVMe Wear Level",
        "type": "bargauge",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 13},
        "targets": [{"expr": "smartctl_device_percentage_used{device=~\"nvme.*\"}", "legendFormat": "{{device}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}},
        "options": {"orientation": "horizontal", "displayMode": "gradient"}
      },
      {
        "id": 8,
        "title": "Disk I/O",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 24, "x": 0, "y": 19},
        "targets": [
          {"expr": "rate(node_disk_read_bytes_total{device=~\"sd.*|nvme.*\"}[5m])", "legendFormat": "{{device}} read", "refId": "A"},
          {"expr": "-rate(node_disk_written_bytes_total{device=~\"sd.*|nvme.*\"}[5m])", "legendFormat": "{{device}} write", "refId": "B"}
        ],
        "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "fillOpacity": 10}}}
      }
    ]
  },
  "folderId": 0,
  "overwrite": true
}
