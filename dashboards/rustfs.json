{
  "dashboard": {
    "id": null,
    "uid": "rustfs",
    "title": "RustFS",
    "tags": ["rustfs", "s3"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "id": 100,
        "title": "Overview",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
        "collapsed": false
      },
      {
        "id": 10,
        "title": "Current RPS",
        "description": "Requests per second (5m average)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
        "targets": [{"expr": "sum(rate(rustfs_rustfs_api_requests_total[5m]))", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps", "thresholds": {"steps": [{"color": "green", "value": null}]}}},
        "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"}
      },
      {
        "id": 11,
        "title": "Status",
        "description": "Process running status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
        "targets": [{"expr": "sum(rustfs_process_status)", "refId": "A"}],
        "fieldConfig": {
          "defaults": {
            "mappings": [{"type": "range", "options": {"from": 1, "to": 1000, "result": {"text": "Running", "color": "green"}}}],
            "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
          }
        },
        "options": {"colorMode": "background", "graphMode": "none", "textMode": "auto"}
      },
      {
        "id": 3,
        "title": "CPU Usage",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
        "targets": [{"expr": "rustfs_process_cpu_usage_percent * 100", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 80}]}}}
      },
      {
        "id": 4,
        "title": "Memory Usage",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
        "targets": [{"expr": "rustfs_process_memory_usage_byte", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "max": 1073741824, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 536870912}, {"color": "red", "value": 858993459}]}}}
      },
      {
        "id": 5,
        "title": "Total Requests",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
        "targets": [{"expr": "sum(rustfs_rustfs_api_requests_total)", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short"}},
        "options": {"colorMode": "value", "graphMode": "area"}
      },
      {
        "id": 6,
        "title": "Restarts",
        "description": "Number of times RustFS has started",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
        "targets": [{"expr": "rustfs_rustfs_audit_system_starts_total", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 10}]}}},
        "options": {"colorMode": "value", "graphMode": "none"}
      },
      {
        "id": 101,
        "title": "Request Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
        "collapsed": false
      },
      {
        "id": 1,
        "title": "API Requests Rate",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6},
        "targets": [{"expr": "sum(rate(rustfs_rustfs_api_requests_total[5m])) by (key_request_method)", "legendFormat": "{{key_request_method}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 20}}}
      },
      {
        "id": 2,
        "title": "Request Latency Percentiles",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 12, "x": 12, "y": 6},
        "targets": [
          {"expr": "histogram_quantile(0.50, sum(rate(rustfs_rustfs_request_latency_ms_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
          {"expr": "histogram_quantile(0.95, sum(rate(rustfs_rustfs_request_latency_ms_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
          {"expr": "histogram_quantile(0.99, sum(rate(rustfs_rustfs_request_latency_ms_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "ms", "custom": {"drawStyle": "line", "fillOpacity": 10}},
          "overrides": [
            {"matcher": {"id": "byName", "options": "p50"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "p95"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "p99"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}
          ]
        }
      },
      {
        "id": 9,
        "title": "Request Latency Heatmap",
        "type": "heatmap",
        "gridPos": {"h": 7, "w": 12, "x": 0, "y": 13},
        "targets": [{"expr": "sum(increase(rustfs_rustfs_request_latency_ms_bucket[1m])) by (le)", "legendFormat": "{{le}}", "refId": "A", "format": "heatmap"}],
        "fieldConfig": {"defaults": {"unit": "ms"}},
        "options": {"calculate": true, "yAxis": {"unit": "ms"}, "color": {"scheme": "Spectral", "mode": "scheme", "reverse": true}, "cellGap": 1, "showValue": "never"}
      },
      {
        "id": 12,
        "title": "Request Body Size Heatmap",
        "description": "Distribution of upload/request body sizes",
        "type": "heatmap",
        "gridPos": {"h": 7, "w": 12, "x": 12, "y": 13},
        "targets": [{"expr": "sum(increase(rustfs_rustfs_request_body_len_bucket[1m])) by (le)", "legendFormat": "{{le}}", "refId": "A", "format": "heatmap"}],
        "fieldConfig": {"defaults": {"unit": "bytes"}},
        "options": {"calculate": true, "yAxis": {"unit": "bytes"}, "color": {"scheme": "Blues", "mode": "scheme"}, "cellGap": 1, "showValue": "never"}
      },
      {
        "id": 8,
        "title": "Top Endpoints",
        "description": "Most requested paths",
        "type": "table",
        "gridPos": {"h": 7, "w": 24, "x": 0, "y": 20},
        "targets": [{"expr": "topk(10, sum by (key_request_method, key_request_uri_path) (rustfs_rustfs_api_requests_total))", "format": "table", "instant": true, "refId": "A"}],
        "fieldConfig": {
          "overrides": [
            {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "custom.width", "value": 120}]},
            {"matcher": {"id": "byName", "options": "key_request_method"}, "properties": [{"id": "custom.width", "value": 80}]}
          ]
        },
        "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "job": true, "instance": true, "app": true, "exported_job": true, "otel_scope_name": true}, "renameByName": {"key_request_method": "Method", "key_request_uri_path": "Path", "Value": "Requests"}}}]
      },
      {
        "id": 102,
        "title": "I/O Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
        "collapsed": false
      },
      {
        "id": 7,
        "title": "Network I/O",
        "description": "S3 API traffic in/out",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 12, "x": 0, "y": 28},
        "targets": [
          {"expr": "rate(rustfs_process_network_io_byte{direction=\"received\"}[5m])", "legendFormat": "Received", "refId": "A"},
          {"expr": "-rate(rustfs_process_network_io_byte{direction=\"transmitted\"}[5m])", "legendFormat": "Transmitted", "refId": "B"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "fillOpacity": 20}},
          "overrides": [
            {"matcher": {"id": "byName", "options": "Received"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "Transmitted"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]}
          ]
        }
      },
      {
        "id": 13,
        "title": "Disk I/O",
        "description": "Backend storage read/write",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 12, "x": 12, "y": 28},
        "targets": [
          {"expr": "rate(rustfs_process_disk_io_byte{direction=\"read\"}[5m])", "legendFormat": "Read", "refId": "A"},
          {"expr": "-rate(rustfs_process_disk_io_byte{direction=\"write\"}[5m])", "legendFormat": "Write", "refId": "B"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "fillOpacity": 20}},
          "overrides": [
            {"matcher": {"id": "byName", "options": "Read"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "Write"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}
          ]
        }
      }
    ]
  },
  "folderId": 0,
  "overwrite": true
}
